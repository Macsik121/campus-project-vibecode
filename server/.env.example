# Секрет для подписи и верификации JWT (см. ТЗ «.ENV переменные»)
JWT_SECRET=change-me-to-a-long-random-string
# Тип основной БД (шаблон Repository; в MVP поддерживается postgres)
BASE_DB_TYPE=postgres
# Строка подключения к PostgreSQL
DATABASE_URL=postgres://campus:campus@localhost:5432/campus
# Порт HTTP-сервера
PORT=3000
# Время жизни токена (например 12h, 7d)
JWT_EXPIRES_IN=12h
