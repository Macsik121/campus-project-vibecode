# Секрет для подписи и верификации JWT (см. ТЗ «.ENV переменные»)
JWT_SECRET=change-me-to-a-long-random-string
# Внешний порт API в Docker (корневой .env compose; 3000 на машине занят zeer_api)
# API_PORT=3001
# Тип основной БД (шаблон Repository; в MVP поддерживается postgres)
BASE_DB_TYPE=postgres
# Строка подключения к PostgreSQL
DATABASE_URL=postgres://campus:campus@localhost:5432/campus
# Порт HTTP-сервера
PORT=3000
# Время жизни токена (например 12h, 7d)
JWT_EXPIRES_IN=12h
# TLS к БД: включать только для БД с TLS (managed-хостинг). Локально/compose — выключено.
DATABASE_SSL=false
